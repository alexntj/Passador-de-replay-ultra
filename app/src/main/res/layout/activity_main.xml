<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080808">

    <LinearLayout android:id="@+id/screenConnect" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CAP CUT" android:textColor="#FF1A1A" android:textSize="13sp" android:letterSpacing="0.18" android:fontFamily="sans-serif-medium" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Preparar acesso" android:textColor="#FFFFFF" android:textSize="24sp" android:fontFamily="sans-serif-medium" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="#1A0000" android:padding="16dp" android:text="COMO CONECTAR:\n\n1. Toque em “ABRIR SHIZUKU”\n2. Inicie o serviço, se necessário\n3. Autorize o Cap cut no Shizuku\n4. Volte e toque em “JÁ CONECTEI”\n5. Depois valide sua Key" android:textColor="#FFCCCC" android:textSize="13sp" android:lineSpacingExtra="3dp" />
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" app:cardBackgroundColor="#1A0000" app:cardCornerRadius="16dp" app:cardElevation="0dp"><Button android:id="@+id/btnConectar" android:layout_width="match_parent" android:layout_height="54dp" android:background="?attr/selectableItemBackground" android:text="ABRIR SHIZUKU" android:textColor="#FF1A1A" android:textSize="14sp" android:fontFamily="sans-serif-medium" /></androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="#FF1A1A" app:cardCornerRadius="16dp" app:cardElevation="0dp"><Button android:id="@+id/btnJaConectei" android:layout_width="match_parent" android:layout_height="54dp" android:background="?attr/selectableItemBackground" android:text="JÁ CONECTEI" android:textColor="#000000" android:textSize="15sp" android:fontFamily="sans-serif-medium" /></androidx.cardview.widget.CardView>
</LinearLayout>

    <LinearLayout android:id="@+id/screenLogin" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="28dp" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CAP CUT" android:textColor="#FF1A1A" android:textSize="13sp" android:letterSpacing="0.18" android:fontFamily="sans-serif-medium" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Acesso autorizado" android:textColor="#FFFFFF" android:textSize="25sp" android:fontFamily="sans-serif-medium" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="Insira sua Key para liberar o sistema." android:textColor="#AAAAAA" android:textSize="14sp" />
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" app:cardBackgroundColor="#1A0000" app:cardCornerRadius="18dp" app:cardElevation="0dp"><EditText android:id="@+id/etKey" android:layout_width="match_parent" android:layout_height="58dp" android:background="@android:color/transparent" android:hint="Digite sua Key" android:inputType="textVisiblePassword" android:paddingStart="18dp" android:paddingEnd="18dp" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#777777" android:textSize="15sp" /></androidx.cardview.widget.CardView>
        <Button android:id="@+id/btnSaveKey" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:background="@drawable/btn_outline" android:text="SALVAR KEY" android:textColor="#FF7777" android:textSize="12sp" />
        <Button android:id="@+id/btnValidateKey" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:background="@drawable/btn_primary" android:text="LOGIN" android:textColor="#000000" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
        <Button android:id="@+id/btnOfficialGroup" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="14dp" android:background="@drawable/btn_outline" android:text="GRUPO OFC" android:textColor="#FF7777" android:textSize="12sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/tvKeyStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="Aguardando validação" android:textColor="#888888" android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/screenDirection" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center_vertical" android:orientation="horizontal"><Button android:id="@+id/btnMenuDirection" android:layout_width="52dp" android:layout_height="52dp" android:background="@android:color/transparent" android:text="☰" android:textColor="#FF5555" android:textSize="28sp" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CAP CUT" android:textColor="#FF1A1A" android:textSize="12sp" android:letterSpacing="0.16" android:fontFamily="sans-serif-medium" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Passador de replay" android:textColor="#FFFFFF" android:textSize="21sp" android:fontFamily="sans-serif-medium" /></LinearLayout></LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:gravity="center" android:text="Escolha a direção do passador" android:textColor="#AAAAAA" android:textSize="14sp" />
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" app:cardBackgroundColor="#1A0000" app:cardCornerRadius="18dp" app:cardElevation="0dp"><Button android:id="@+id/btnMaxToNormal" android:layout_width="match_parent" android:layout_height="70dp" android:background="?attr/selectableItemBackground" android:text="BYPASS FF MAX PARA FF" android:textColor="#FF7777" android:textSize="15sp" /></androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="#1A0000" app:cardCornerRadius="18dp" app:cardElevation="0dp"><Button android:id="@+id/btnNormalToMax" android:layout_width="match_parent" android:layout_height="70dp" android:background="?attr/selectableItemBackground" android:text="BYPASS FF PARA FF MAX" android:textColor="#FF7777" android:textSize="15sp" /></androidx.cardview.widget.CardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center" android:text="Selecione uma opção para continuar" android:textColor="#666666" android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/screenTransfer" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal"><Button android:id="@+id/btnMenuTransfer" android:layout_width="52dp" android:layout_height="52dp" android:background="@android:color/transparent" android:text="☰" android:textColor="#FF5555" android:textSize="28sp" /><TextView android:id="@+id/tvTransferTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="FF MAX  →  FF NORMAL" android:textColor="#FFFFFF" android:textSize="18sp" android:fontFamily="sans-serif-medium" /></LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="Sincronização segura entre os replays" android:textColor="#777777" android:textSize="12sp" />
        <TextView android:id="@+id/tvVersionNormal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/version_normal" android:padding="12dp" android:text="Normal: —" android:textColor="#B8E7FF" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/tvVersionMax" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/version_max" android:padding="12dp" android:text="Max: —" android:textColor="#FFD0D0" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/status_card" android:padding="10dp" android:text="Verificando..." android:textColor="#FF7777" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="#180000" android:padding="10dp" android:text="PRIV CONSOLE  •  LOGS DE SINCRONIZAÇÃO" android:textColor="#FF7777" android:textSize="11sp" android:fontFamily="sans-serif-medium" />
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" app:cardBackgroundColor="#100606" app:cardCornerRadius="16dp" app:cardElevation="0dp"><ScrollView android:id="@+id/logScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="14dp" android:fillViewport="true"><TextView android:id="@+id/logBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#CCCCCC" android:textSize="12sp" android:fontFamily="monospace" android:lineSpacingExtra="2dp" /></ScrollView></androidx.cardview.widget.CardView>
        <Button android:id="@+id/btnPassar" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:background="@drawable/btn_primary" android:text="START CAP CUT" android:textColor="#000000" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
        <Button android:id="@+id/btnBypass" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:background="@drawable/btn_danger" android:text="BYPASS" android:textColor="#FFFFFF" android:textSize="15sp" android:visibility="gone" />
    </LinearLayout>

    <LinearLayout android:id="@+id/screenTextures" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center_vertical" android:orientation="horizontal"><Button android:id="@+id/btnMenuTextures" android:layout_width="52dp" android:layout_height="52dp" android:background="@android:color/transparent" android:text="☰" android:textColor="#FF5555" android:textSize="28sp" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CAP CUT" android:textColor="#FF1A1A" android:textSize="12sp" android:letterSpacing="0.16" android:fontFamily="sans-serif-medium" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Texturas" android:textColor="#FFFFFF" android:textSize="21sp" android:fontFamily="sans-serif-medium" /></LinearLayout></LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Escolha um pacote para substituir os arquivos correspondentes no FF NORMAL." android:textColor="#999999" android:textSize="13sp" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp" android:fillViewport="true"><LinearLayout android:id="@+id/textureList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" /></ScrollView>
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="#FF1A1A" app:cardCornerRadius="16dp" app:cardElevation="0dp"><Button android:id="@+id/btnInjectTexture" android:layout_width="match_parent" android:layout_height="56dp" android:background="?attr/selectableItemBackground" android:text="INJETAR TEXTURA" android:textColor="#000000" android:textSize="15sp" android:fontFamily="sans-serif-medium" /></androidx.cardview.widget.CardView>
        <TextView android:id="@+id/tvTextureStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="Selecione uma textura" android:textColor="#888888" android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/screenBypassSs" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center_vertical" android:orientation="horizontal"><Button android:id="@+id/btnMenuBypassSs" android:layout_width="52dp" android:layout_height="52dp" android:background="@android:color/transparent" android:text="☰" android:textColor="#FF5555" android:textSize="28sp" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CAP CUT" android:textColor="#FF1A1A" android:textSize="12sp" android:letterSpacing="0.16" android:fontFamily="sans-serif-medium" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Bypass SS" android:textColor="#FFFFFF" android:textSize="21sp" android:fontFamily="sans-serif-medium" /></LinearLayout></LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Diagnóstico e limpeza do estado deste aplicativo" android:textColor="#999999" android:textSize="13sp" />
        <TextView android:id="@+id/tvAndroidVersion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/version_normal" android:padding="14dp" android:text="ANDROID\n—" android:textColor="#B8E7FF" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/tvDeviceModel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/version_max" android:padding="14dp" android:text="MODELO\n—" android:textColor="#FFD0D0" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/tvShizukuState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/status_card" android:padding="14dp" android:text="SHIZUKU\nVerificando..." android:textColor="#FF7777" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="14dp" app:cardBackgroundColor="#100606" app:cardCornerRadius="16dp" app:cardElevation="0dp"><ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="14dp"><TextView android:id="@+id/ssLogBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#CCCCCC" android:textSize="12sp" android:fontFamily="monospace" android:lineSpacingExtra="3dp" /></ScrollView></androidx.cardview.widget.CardView>
        <Button android:id="@+id/btnSsCleanup" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="14dp" android:background="@drawable/btn_danger" android:text="LIMPAR LOGS DO APP E DESINSTALAR" android:textColor="#FFFFFF" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <View android:id="@+id/menuBackdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:clickable="true" android:focusable="true" android:visibility="gone" />
    <LinearLayout android:id="@+id/screenMode" android:layout_width="300dp" android:layout_height="match_parent" android:layout_gravity="start" android:orientation="vertical" android:padding="22dp" android:background="#F0100808" android:elevation="20dp" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="MENU PRINCIPAL" android:textColor="#FF5555" android:textSize="12sp" android:letterSpacing="0.15" android:fontFamily="sans-serif-medium" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Navegação" android:textColor="#FFFFFF" android:textSize="24sp" android:fontFamily="sans-serif-medium" />
        <Button android:id="@+id/btnReplayMode" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="26dp" android:background="@drawable/btn_outline" android:text="PASSADOR DE REPLAY" android:textColor="#FF7777" android:textSize="13sp" />
        <Button android:id="@+id/btnTextureMode" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:background="@drawable/btn_primary" android:text="TEXTURAS" android:textColor="#000000" android:textSize="13sp" />
        <Button android:id="@+id/btnBypassSsMenu" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:background="@drawable/btn_outline" android:text="BYPASS SS" android:textColor="#FF7777" android:textSize="13sp" />
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <Button android:id="@+id/btnExitMenu" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/btn_danger" android:text="SAIR" android:textColor="#FFFFFF" android:textSize="13sp" />
        <Button android:id="@+id/btnCloseMenu" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:background="@android:color/transparent" android:text="FECHAR" android:textColor="#777777" android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
